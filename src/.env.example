# =============================================================================
# NEXORA — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env before running if custom overrides are desired.
# DO NOT commit real secrets or credentials to source control.
# =============================================================================

# Flask Backend API Server Port
APP_PORT=5001

# Flask Debug Mode (True / False)
FLASK_DEBUG=False

# SQLite Database Path (Defaults to local database)
DATABASE_URL=sqlite:///src/backend/database/nexora.db

# Optional IBM Cloud / Bob Integration Credentials (if configured)
IBM_BOB_API_KEY=
IBM_BOB_PROJECT_ID=
IBM_BOB_ENDPOINT=https://us-south.ml.cloud.ibm.com
